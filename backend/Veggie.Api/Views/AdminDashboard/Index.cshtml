@using Veggie.Api.Controllers
@using Veggie.Api.Models.Entities
@{Layout="~/Views/Shared/_AdminLayout.cshtml";ViewData["Title"]="Dashboard";var chart=(List<AdminDashboardController.RevenueSummary>)ViewData["Chart"]!;var max=Math.Max(1,chart.Max(c=>c.Amount));var categories=(List<AdminDashboardController.CategorySummary>)ViewData["Categories"]!;var colors=new[]{"#bdc3c7","#9b59b6","#e74c3c","#1abb9c","#3498db"};var total=Math.Max(1,categories.Sum(c=>c.Count));decimal angle=0;var stops=new List<string>();for(var n=0;n<categories.Count;n++){var end=angle+360m*categories[n].Count/total;stops.Add($"{colors[n%colors.Length]} {angle.ToString(System.Globalization.CultureInfo.InvariantCulture)}deg {end.ToString(System.Globalization.CultureInfo.InvariantCulture)}deg");angle=end;}}
<div class="va-stats"><div class="va-stat"><small><i class="fa fa-user"></i> Tổng số người dùng</small><strong>@ViewData["Users"]</strong></div><div class="va-stat"><small><i class="fa fa-bar-chart"></i> Tổng số lượng sản phẩm</small><strong>@ViewData["Products"]</strong></div><div class="va-stat"><small><i class="fa fa-shopping-cart"></i> Tổng số lượng đơn hàng</small><strong>@ViewData["Orders"]</strong></div><div class="va-stat"><small><i class="fa fa-money"></i> Tổng doanh thu đã thanh toán</small><strong>@(((decimal)ViewData["Revenue"]!).ToString("N0")) ₫</strong></div></div>
<div class="va-dashboard-top"><section class="va-panel"><div class="va-panel-title"><h2>Doanh thu</h2><small>7 ngày gần nhất</small></div><div class="va-chart">@foreach(var c in chart){<div style="height:@((c.Amount/max*100).ToString("0",System.Globalization.CultureInfo.InvariantCulture))%" title="@c.Day.ToString("dd/MM"): @c.Amount.ToString("N0") ₫"><small>@c.Amount.ToString("N0") ₫</small><span>@c.Day.ToString("dd/MM")</span></div>}</div></section>
<section class="va-panel"><div class="va-panel-title"><h2>Danh mục</h2>@if(User.IsInRole("Admin")){<a href="/admin/categories">Danh sách</a>}</div><div class="va-category-chart"><div><small>Top @categories.Count</small><div class="va-donut" style="background:conic-gradient(@string.Join(",",stops))"><span>@categories.Sum(c=>c.Count)<small>Sản phẩm</small></span></div></div><table><thead><tr><th>Danh mục</th><th>Sản phẩm</th></tr></thead><tbody>@for(var n=0;n<categories.Count;n++){var c=categories[n];<tr><td><i class="va-legend" style="background:@colors[n%colors.Length]"></i>@c.Name</td><td>@c.Count</td></tr>}</tbody></table></div></section>
<section class="va-panel"><div class="va-panel-title"><h2>Sản phẩm bán chạy nhất</h2><a href="/admin/products">Danh sách</a></div><table class="va-sellers"><thead><tr><th>#</th><th>Ảnh</th><th>Tên sản phẩm</th><th>Giá</th><th>Đã bán</th></tr></thead><tbody>@{var bestSellers=(List<AdminDashboardController.SellerSummary>)ViewData["BestSellers"]!;}@if(bestSellers.Count==0){<tr><td colspan="5" class="va-sellers-empty">Chưa có sản phẩm từ đơn giao thành công để xếp hạng.</td></tr>}@foreach(var p in bestSellers){<tr><td>@p.Id</td><td>@if(p.Image is not null){<img src="@(p.Image.StartsWith("/")?p.Image:"/clients/"+p.Image)" alt="@p.Name">}</td><td>@p.Name</td><td>@p.Price.ToString("N0") ₫</td><td>@p.Quantity</td></tr>}</tbody></table></section></div>
@if(User.IsInRole("Admin")){<div class="va-dashboard-bottom"><section class="va-panel"><div class="va-panel-title"><h2>Người dùng mới</h2><a href="/admin/users">Danh sách</a></div><div class="va-table-wrap"><table><thead><tr><th>#</th><th>Khách hàng</th><th>Số điện thoại</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var u in (List<User>)ViewData["RecentUsers"]!){<tr><td>@u.Id</td><td>@u.Name</td><td>@(u.PhoneNumber??"—")</td><td><span class="va-badge @(u.Status?"":"off")">@(u.Status?"Đã kích hoạt":"Đã khóa")</span></td></tr>}</tbody></table></div></section>
<section class="va-panel"><div class="va-panel-title"><h2>Đơn hàng mới</h2><a href="/admin/orders">Danh sách</a></div><div class="va-table-wrap"><table><thead><tr><th>#</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Ngày đặt hàng</th><th>Xem chi tiết</th></tr></thead><tbody>@foreach(var o in (List<Order>)ViewData["RecentOrders"]!){<tr><td><a href="/admin/orders/@o.Id/details">VG@(o.Id)</a></td><td>@o.User.Name</td><td>@o.TotalPrice.ToString("N0") ₫</td><td><span class="va-badge warn">@(o.Status switch{"pending"=>"Chờ xác nhận","confirmed"=>"Đã xác nhận","shipping"=>"Đang giao","delivered"=>"Đã giao","cancelled"=>"Đã hủy",_=>o.Status})</span></td><td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><a class="btn va-edit" href="/admin/orders/@o.Id/details">Xem chi tiết</a></td></tr>}</tbody></table></div></section></div>
}

