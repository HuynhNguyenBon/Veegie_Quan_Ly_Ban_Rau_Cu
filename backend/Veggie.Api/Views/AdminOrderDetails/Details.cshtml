@model Veggie.Api.Models.Entities.Order
@{Layout="~/Views/Shared/_AdminLayout.cshtml";ViewData["Title"]="Chi tiết đơn VG"+Model.Id;var subtotal=Model.OrderItems.Sum(i=>i.Price*i.Quantity);}
<div class="va-heading"><h1>Hóa đơn VG@(Model.Id)</h1><a href="/admin/orders">← Danh sách đơn hàng</a></div>
<section class="va-panel"><div class="va-panel-title"><h2>Thông tin giao hàng</h2><span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></div><p><strong>@Model.ShippingAddress.FullName</strong> · @Model.ShippingAddress.Phone</p><p>@Model.ShippingAddress.Address · @Model.ShippingAddress.City</p><p>Tài khoản: @Model.User.Name · @Model.User.Email</p><p>Trạng thái: @(Model.Status switch {"pending"=>"Chờ xác nhận","confirmed"=>"Đã xác nhận","shipping"=>"Đang giao","delivered"=>"Đã giao","cancelled"=>"Đã hủy",_=>Model.Status})</p><p>Thanh toán: @(Model.Payment?.PaymentMethod=="COD"?"Khi nhận hàng":"Chuyển khoản") · @(Model.Payment?.Status=="paid"?"Đã thanh toán":"Chưa thanh toán")</p></section>
<section class="va-panel"><div class="va-panel-title"><h2>Chi tiết sản phẩm</h2></div><table><thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var i in Model.OrderItems){var photo=i.Product.ProductImages.OrderBy(p=>p.Id).FirstOrDefault()?.Image;<tr><td>@if(photo is not null){<img class="va-thumb" src="@(photo.StartsWith("/")?photo:"/clients/"+photo)" alt="">}</td><td>@i.Product.Name</td><td>@i.Price.ToString("N0") ₫</td><td>@i.Quantity @i.Product.Unit</td><td>@((i.Price*i.Quantity).ToString("N0")) ₫</td></tr>}</tbody></table><p style="text-align:right;margin-top:20px">Tiền hàng: @subtotal.ToString("N0") ₫<br>Phí giao hàng: @((Model.TotalPrice-subtotal).ToString("N0")) ₫<br><strong>Tổng: @Model.TotalPrice.ToString("N0") ₫</strong></p>
@if(ViewData["Mail"] is Veggie.Api.Models.Entities.StoreEmail mail){<p role="status" class="@(mail.SentAt!=null?"va-payment-success":mail.Attempts>=5?"va-payment-error":"")">@(mail.SentAt!=null?"Đã gửi hóa đơn qua email.":mail.Attempts>=5?"Gửi hóa đơn thất bại.":"Hóa đơn đang chờ gửi.")</p>}
@if(Model.Status is not ("pending" or "cancelled")){<div class="va-actions"><button type="button" onclick="window.print()">In / lưu PDF</button><form method="post" action="/admin/orders/@Model.Id/invoice">@Html.AntiForgeryToken()<button type="submit">Gửi hóa đơn</button></form></div>}
</section><section class="va-panel"><h2>Lịch sử xử lý</h2>@foreach(var h in Model.OrderStatusHistories.OrderByDescending(h=>h.Id)){<p>@h.CreatedAt.ToString("dd/MM/yyyy HH:mm") · @h.Status · @h.Note</p>}</section>
